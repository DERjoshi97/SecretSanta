# Kopiere diese Datei nach .env und trage deine SMTP-Zugangsdaten ein.
# Ohne SMTP_HOST läuft die App im Testmodus (Mails erscheinen nur in der Konsole).

PORT=3000

# Passwort, mit dem sich der Organisator anmeldet.
# Leer = bei jedem Start wird ein zufälliges Passwort erzeugt und in der Konsole angezeigt.
ORGANIZER_PASSWORD=

# Geheimer Schlüssel zum Signieren der Anmeldung und der Bestätigungslinks in den Mails
# (lange Zufallszeichenkette). WICHTIG: fest setzen! Ist er leer, wird bei jedem Start ein
# neuer erzeugt – dann funktionieren bereits verschickte Bestätigungslinks nicht mehr.
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Öffentliche Adresse der App, wie sie in den Bestätigungslinks der Mails steht.
# Leer = die Adresse, über die der Organisator die App gerade aufgerufen hat.
# Hinweis: http://localhost:... funktioniert nur auf deinem eigenen Rechner!
PUBLIC_URL=

# true setzen, wenn die App hinter einem Reverse-Proxy läuft (z. B. bei einem Hoster mit HTTPS)
TRUST_PROXY=false

# Beispiel Gmail: smtp.gmail.com, Port 465, App-Passwort verwenden
#   (https://myaccount.google.com/apppasswords – setzt 2-Faktor-Anmeldung voraus)
# Beispiel GMX:   mail.gmx.net, Port 587
# Beispiel Web.de: smtp.web.de, Port 587
SMTP_HOST=
SMTP_PORT=587
# Optional: true/false. Standard: true bei Port 465, sonst false (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Absender, wie er in der Mail angezeigt wird
MAIL_FROM="Wichteln <deine-adresse@example.com>"

# true = nie echte Mails verschicken, auch wenn SMTP konfiguriert ist
MAIL_DRY_RUN=false
